{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Smoothie Registration Service",
            "type": "debugpy",
            "request": "launch",
            "program": "${fileWorkspaceFolder:smoothie-registration}/main.py",
            "cwd": "${fileWorkspaceFolder:smoothie-registration}",
            "python": "${fileWorkspaceFolder:smoothie-registration}/.venv/Scripts/python.exe",
            "console": "integratedTerminal",
            "justMyCode": true,
            "envFile": "${fileWorkspaceFolder:smoothie-registration}/.env",
            "env": {
                "PYDEVD_DISABLE_FILE_VALIDATION": "1"
            }
        }
    ]
}
