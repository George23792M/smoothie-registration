{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387

    // Using fileWorkspaceFolder instead of workspaceFolder to support multi-root workspaces
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Smoothie Registration Service",
            "type": "debugpy",
            "request": "launch",
            "program": "${fileWorkspaceFolder}/main.py",
            "cwd": "${fileWorkspaceFolder}",
            "python": "${fileWorkspaceFolder}/.venv/Scripts/python.exe",
            "console": "integratedTerminal",
            "justMyCode": true,
            "envFile": "${fileWorkspaceFolder}/.env",
            "env": {
                "PYDEVD_DISABLE_FILE_VALIDATION": "1"
            }
        }
    ]
}
